# Optional: GitHub personal access token (public_repo read-only) for higher ISR rate limits (5,000 req/hr).
# Without it, public unauthenticated GitHub requests (60 req/hr, cached for 1 hour) work automatically.
GITHUB_TOKEN=

# Optional: Canonical production URL once deployed (e.g. https://zine-portfolio.vercel.app)
NEXT_PUBLIC_SITE_URL=
